generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEAD
  EMPLOYEE
}

enum Half {
  FULL
  FIRST
  SECOND
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LedgerKind {
  OPENING
  MONTHLY_CREDIT
  YEARLY_CREDIT
  LEAVE
  REFUND
  CARRY_FORWARD
  EXPIRY
  MANUAL
}

model User {
  id                 Int            @id @default(autoincrement())
  employeeId         String         @unique
  name               String
  email              String         @unique
  passwordHash       String
  role               Role           @default(EMPLOYEE)
  departmentId       Int?
  department         Department?    @relation(fields: [departmentId], references: [id])
  managerId          Int?
  manager            User?          @relation("Reports", fields: [managerId], references: [id])
  reports            User[]         @relation("Reports")
  joiningDate        DateTime       @db.Date
  isActive           Boolean        @default(true)
  onNoticePeriod     Boolean        @default(false)
  mustChangePassword Boolean        @default(true)
  createdAt          DateTime       @default(now())
  leaves             LeaveRequest[] @relation("Applicant")
  decisions          LeaveRequest[] @relation("Approver")
  ledger             LeaveLedger[]  @relation("LedgerUser")
  ledgerEntries      LeaveLedger[]  @relation("LedgerCreator")
  documents          Document[]
  passwordResets     PasswordReset[]
  auditActions       AuditLog[]     @relation("AuditActor")
  auditSubjects      AuditLog[]     @relation("AuditTargetUser")
  tasksAssigned      Task[]         @relation("TaskAssignee")
  tasksCreated       Task[]         @relation("TaskCreator")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  actorId      Int?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId Int?
  targetUser   User?    @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Department {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
  tasks Task[]
}

enum TaskStatus {
  TODO
  DOING
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MED
  HIGH
}

// Generic team task. Per-team fields and workflows come later; `kind` is a free label
// (e.g. "Project task", "Review", "Onboarding") until each team's needs are settled.
model Task {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  kind         String       @default("Task")
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MED)
  dueDate      DateTime?    @db.Date
  departmentId Int?
  department   Department?  @relation(fields: [departmentId], references: [id])
  assigneeId   Int?
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById  Int
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  @@index([departmentId, status])
  @@index([assigneeId, status])
}

model LeaveType {
  id                  Int            @id @default(autoincrement())
  code                String         @unique
  name                String
  monthlyCredit       Decimal        @default(0) @db.Decimal(4, 1)
  // Credited each January; pro-rated for joiners in their first year.
  yearlyQuota         Decimal        @default(0) @db.Decimal(4, 1)
  // Balance above this expires at year end. null = never expires.
  maxCarryForward     Decimal?       @db.Decimal(4, 1)
  needsBalance        Boolean        @default(true)
  allowHalfDay        Boolean        @default(true)
  sandwichCounts      Boolean        @default(false)
  backdateDays        Int            @default(0)
  noticeDays          Int            @default(0)
  // Leaves longer than longLeaveDays need longNoticeDays' notice instead of noticeDays.
  longLeaveDays       Int?
  longNoticeDays      Int            @default(0)
  // Can't be applied during probation (monthly credits are held until it ends) / notice period.
  blockedOnProbation  Boolean        @default(false)
  blockedOnNotice     Boolean        @default(false)
  // Show a medical-certificate reminder above this many days.
  certificateAfterDays Int?
  optionalHolidayOnly Boolean        @default(false)
  isActive            Boolean        @default(true)
  requests            LeaveRequest[]
  ledger              LeaveLedger[]
}

model LeaveLedger {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("LedgerUser", fields: [userId], references: [id])
  leaveTypeId    Int
  leaveType      LeaveType     @relation(fields: [leaveTypeId], references: [id])
  days           Decimal       @db.Decimal(5, 1)
  kind           LedgerKind
  // e.g. "2026-11" for monthly credit, "2026" for yearly; null for one-off rows
  period         String?
  leaveRequestId Int?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
  note           String?
  createdById    Int?
  createdBy      User?         @relation("LedgerCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  // Scheduled jobs are safe to re-run: one credit per user/type/kind/period.
  @@unique([userId, leaveTypeId, kind, period])
  @@index([userId, leaveTypeId])
}

model LeaveRequest {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("Applicant", fields: [userId], references: [id])
  leaveTypeId    Int
  leaveType      LeaveType     @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  startHalf      Half          @default(FULL)
  endHalf        Half          @default(FULL)
  days           Decimal       @db.Decimal(4, 1)
  reason         String
  note           String?
  ccEmails       String[]
  status         LeaveStatus   @default(PENDING)
  approverId     Int?
  approver       User?         @relation("Approver", fields: [approverId], references: [id])
  decisionReason String?
  decidedAt      DateTime?
  gcalEventId    String?
  createdAt      DateTime      @default(now())
  ledger         LeaveLedger[]

  @@index([userId, status])
}

model Holiday {
  id         Int      @id @default(autoincrement())
  date       DateTime @unique @db.Date
  name       String
  isOptional Boolean  @default(false)
}

model Setting {
  key   String @id
  value Json
}

model Document {
  id           Int      @id @default(autoincrement())
  title        String
  fileName     String
  size         Int
  // Stored in the DB so backups cover it and there's no upload folder to manage. PDFs only, ≤10 MB.
  data         Bytes
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}
