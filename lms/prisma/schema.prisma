generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEAD
  EMPLOYEE
}

enum EmploymentType {
  PERMANENT
  INTERN
}

enum Half {
  FULL
  FIRST
  SECOND
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LedgerKind {
  OPENING
  MONTHLY_CREDIT
  YEARLY_CREDIT
  LEAVE
  REFUND
  CARRY_FORWARD
  EXPIRY
  MANUAL
}

model User {
  id                 Int                 @id @default(autoincrement())
  employeeId         String              @unique
  name               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(EMPLOYEE)
  departmentId       Int?
  department         Department?         @relation(fields: [departmentId], references: [id])
  managerId          Int?
  manager            User?               @relation("Reports", fields: [managerId], references: [id])
  reports            User[]              @relation("Reports")
  joiningDate        DateTime            @db.Date
  isActive           Boolean             @default(true)
  onNoticePeriod     Boolean             @default(false)
  employmentType     EmploymentType      @default(PERMANENT)
  internshipEndDate  DateTime?           @db.Date
  mustChangePassword Boolean             @default(true)
  createdAt          DateTime            @default(now())
  leaves             LeaveRequest[]      @relation("Applicant")
  decisions          LeaveRequest[]      @relation("Approver")
  ledger             LeaveLedger[]       @relation("LedgerUser")
  ledgerEntries      LeaveLedger[]       @relation("LedgerCreator")
  documents          Document[]
  passwordResets     PasswordReset[]
  auditActions       AuditLog[]          @relation("AuditActor")
  auditSubjects      AuditLog[]          @relation("AuditTargetUser")
  tasksAssigned      Task[]              @relation("TaskAssignee")
  performanceReports PerformanceReport[] @relation("ReportAuthor")
  reportsReviewed    PerformanceReport[] @relation("ReportReviewer")
  invoicesCreated    Invoice[]
  tasksCreated       Task[]              @relation("TaskCreator")
  validations        Validation[]
  validationFiles    ValidationFile[]
  notifications      Notification[]
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  actorId      Int?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId Int?
  targetUser   User?    @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Department {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
  tasks Task[]
}

enum TaskStatus {
  TODO
  DOING
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MED
  HIGH
}

// Generic team task. Per-team fields and workflows come later; `kind` is a free label
// (e.g. "Project task", "Review", "Onboarding") until each team's needs are settled.
model Task {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  kind         String       @default("Task")
  // Team-specific fields (see lib/team-config.ts), e.g. { "type": "Bug fix", "project": "OfferCarnival" }
  fields       Json         @default("{}")
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MED)
  dueDate      DateTime?    @db.Date
  departmentId Int?
  department   Department?  @relation(fields: [departmentId], references: [id])
  assigneeId   Int?
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById  Int
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  // Set on tasks the daily job creates (e.g. "intern-end:12:2027-03-31"), so it never creates one twice.
  autoKey      String?      @unique

  @@index([departmentId, status])
  @@index([assigneeId, status])
}

model LeaveType {
  id                   Int            @id @default(autoincrement())
  code                 String         @unique
  name                 String
  monthlyCredit        Decimal        @default(0) @db.Decimal(4, 1)
  // Credited each January; pro-rated for joiners in their first year.
  yearlyQuota          Decimal        @default(0) @db.Decimal(4, 1)
  // Balance above this expires at year end. null = never expires.
  maxCarryForward      Decimal?       @db.Decimal(4, 1)
  needsBalance         Boolean        @default(true)
  allowHalfDay         Boolean        @default(true)
  sandwichCounts       Boolean        @default(false)
  backdateDays         Int            @default(0)
  noticeDays           Int            @default(0)
  // Leaves longer than longLeaveDays need longNoticeDays' notice instead of noticeDays.
  longLeaveDays        Int?
  longNoticeDays       Int            @default(0)
  // Can't be applied during probation (monthly credits are held until it ends) / notice period.
  blockedOnProbation   Boolean        @default(false)
  blockedOnNotice      Boolean        @default(false)
  // Show a medical-certificate reminder above this many days.
  certificateAfterDays Int?
  optionalHolidayOnly  Boolean        @default(false)
  isActive             Boolean        @default(true)
  requests             LeaveRequest[]
  ledger               LeaveLedger[]
}

model LeaveLedger {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("LedgerUser", fields: [userId], references: [id])
  leaveTypeId    Int
  leaveType      LeaveType     @relation(fields: [leaveTypeId], references: [id])
  days           Decimal       @db.Decimal(5, 1)
  kind           LedgerKind
  // e.g. "2026-11" for monthly credit, "2026" for yearly; null for one-off rows
  period         String?
  leaveRequestId Int?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
  note           String?
  createdById    Int?
  createdBy      User?         @relation("LedgerCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  // Scheduled jobs are safe to re-run: one credit per user/type/kind/period.
  @@unique([userId, leaveTypeId, kind, period])
  @@index([userId, leaveTypeId])
}

model LeaveRequest {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("Applicant", fields: [userId], references: [id])
  leaveTypeId    Int
  leaveType      LeaveType     @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  startHalf      Half          @default(FULL)
  endHalf        Half          @default(FULL)
  days           Decimal       @db.Decimal(4, 1)
  reason         String
  note           String?
  ccEmails       String[]
  status         LeaveStatus   @default(PENDING)
  approverId     Int?
  approver       User?         @relation("Approver", fields: [approverId], references: [id])
  decisionReason String?
  decidedAt      DateTime?
  gcalEventId    String?
  createdAt      DateTime      @default(now())
  ledger         LeaveLedger[]

  @@index([userId, status])
}

model Holiday {
  id         Int      @id @default(autoincrement())
  date       DateTime @unique @db.Date
  name       String
  isOptional Boolean  @default(false)
}

model Setting {
  key   String @id
  value Json
}

model Document {
  id           Int      @id @default(autoincrement())
  title        String
  fileName     String
  size         Int
  // Stored in the DB so backups cover it and there's no upload folder to manage. PDFs only, ≤10 MB.
  data         Bytes
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}

enum ReportStatus {
  DRAFT
  SUBMITTED
}

// Monthly performance report. `data` follows ReportData in lib/team-config.ts;
// attendance is worked out from leave records when the report is shown, never typed in.
model PerformanceReport {
  id              Int          @id @default(autoincrement())
  userId          Int
  user            User         @relation("ReportAuthor", fields: [userId], references: [id])
  month           String // "2026-10"
  team            String? // team name when created; picks the template
  designation     String       @default("")
  data            Json
  status          ReportStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewerComment String?
  reviewedById    Int?
  reviewedBy      User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, month])
  @@index([month])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

// Finance team invoices. "Overdue" isn't stored: it's SENT with a due date in the past.
model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  client      String
  description String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  issueDate   DateTime      @db.Date
  dueDate     DateTime      @db.Date
  status      InvoiceStatus @default(DRAFT)
  paidDate    DateTime?     @db.Date
  notes       String?
  createdById Int
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, dueDate])
}

model EmployeeIdCounter {
  role       Role @id
  lastNumber Int  @default(0)
}

// ---------- Affiliate validations ----------
// One table for both sides; SALES (client approves revenue) and DELIVERY (we owe a publisher)
// keep separate numbering, statuses, access and pages. Shared campaign ties them together.

enum ValidationSide {
  SALES
  DELIVERY
}

enum OfferModel {
  CPI
  CPA
  CPS
  CPL
  CPR
}

enum Platform {
  ANDROID
  IOS
  WEB
}

// Union of both sides' statuses; lib/affiliate-rules.ts says which apply to which side.
enum ValidationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_FINANCE_REVIEW
  READY_TO_SEND
  SENT_TO_PUBLISHER
  ACKNOWLEDGED
  DISPUTED
  REVISED
  APPROVED
  PARTIALLY_APPROVED
  INVOICE_RECEIVED
  PAYMENT_PENDING
  PAID
  CLOSED
}

model Advertiser {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  campaigns Campaign[]
}

model Campaign {
  id           Int          @id @default(autoincrement())
  advertiserId Int
  advertiser   Advertiser   @relation(fields: [advertiserId], references: [id])
  name         String
  geo          String?
  platform     Platform?
  offerModel   OfferModel?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  validations  Validation[]

  @@unique([advertiserId, name])
}

model Publisher {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String?      @unique
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  validations Validation[]
}

model Validation {
  id                  Int              @id @default(autoincrement())
  side                ValidationSide
  number              String           @unique
  month               String // YYYY-MM
  campaignId          Int
  campaign            Campaign         @relation(fields: [campaignId], references: [id])
  publisherId         Int? // DELIVERY only
  publisher           Publisher?       @relation(fields: [publisherId], references: [id])
  clientRef           String? // SALES: advertiser's campaign ID
  geo                 String
  platform            Platform?
  offerModel          OfferModel
  totalConversions    Int
  approvedConversions Int
  rejectedConversions Int
  payoutRate          Decimal?         @db.Decimal(14, 4) // DELIVERY only
  amount              Decimal          @db.Decimal(14, 2) // SALES: approved amount; DELIVERY: gross amount
  deduction           Decimal          @default(0) @db.Decimal(14, 2)
  netAmount           Decimal          @db.Decimal(14, 2) // amount - deduction
  currency            String
  invoiceNumber       String? // DELIVERY only
  invoiceDate         DateTime?        @db.Date
  sentDate            DateTime?        @db.Date
  approvedAmount      Decimal?         @db.Decimal(14, 2) // SALES: what Finance approved (the part, if partial)
  revision            Int              @default(0) // bumped each time an approved record is revised
  paidDate            DateTime?        @db.Date // DELIVERY: when the publisher was paid
  paymentRef          String? // DELIVERY: UTR / transaction reference
  importId            String? // bulk upload batch, e.g. IMP-20261125-0930-EMP004
  remarks             String?
  status              ValidationStatus @default(DRAFT)
  submittedAt         DateTime?
  createdById         Int
  createdBy           User             @relation(fields: [createdById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  files               ValidationFile[]

  @@index([side, month])
  @@index([campaignId, month])
  @@index([side, status])
  @@index([importId])
}

// Every upload is kept; files are never replaced. Stored in the DB like policy PDFs.
model ValidationFile {
  id           Int        @id @default(autoincrement())
  validationId Int
  validation   Validation @relation(fields: [validationId], references: [id], onDelete: Cascade)
  fileName     String
  contentType  String
  size         Int
  data         Bytes
  uploadedById Int
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())
}

// In-portal notifications. `key` de-duplicates reminders (one per record per reminder window).
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String
  key       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId, readAt])
}
